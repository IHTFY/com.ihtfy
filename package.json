{
	"name": "ihtfy-website",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"ghdeploy": "pnpm run build && gh-pages -d build --dotfiles --branch gh-pages",
		"preview": "vite preview --host",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"prepare": "svelte-kit sync"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"gh-pages": "^6.3.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prismjs": "^1.30.0",
		"prism-svelte": "^0.5.0",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-slug": "^6.0.0",
		"sass": "^1.105.1",
		"svelte": "^5.57.1",
		"vite": "^8.3.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@eslint/js": "^10.0.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"typescript": "^6.0.3"
	},
	"type": "module",
	"dependencies": {
		"dateformat": "^5.0.3"
	},
	"engines": {
		"node": ">=22.17"
	},
	"packageManager": "pnpm@12.8.1",
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
